{
  // Статический сайт Tilefold: собранная папка public/ (её делает build.mjs и она в репозитории).
  // Своего кода у воркера нет – только файлы. Публикует Cloudflare Workers Builds при пуше в main.
  "name": "tilefold",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
